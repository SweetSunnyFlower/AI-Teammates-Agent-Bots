[Unit]
Description=Dotty web app
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=dotty
Group=dotty
WorkingDirectory=/opt/dotty
EnvironmentFile=/opt/dotty/.env.local
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dotty/.next/cache

[Install]
WantedBy=multi-user.target
