# Dotty environment variables
# Copy this file to .env.local (git-ignored) and fill in the values. Restart `npm run dev` after editing.

# ── Supabase ────────────────────────────────────────────────────────────────
# Where to find these:
#   1. Open https://supabase.com/dashboard and pick your project (or create one).
#   2. Click "Connect" at the top of the project page → choose "App Frameworks" → "Next.js".
#      It shows both values below ready to copy.
#   Or: Project Settings → API Keys  (https://supabase.com/dashboard/project/_/settings/api-keys)
#
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, starts with sb_publishable_  (safe in the browser; RLS protects data).
# Older projects may only show the legacy "anon" key — that works here too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key, starts with sb_secret_ — SERVER ONLY, bypasses RLS. Not needed for sign-in;
# used later by background jobs (Trigger.dev). Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# Public URL of the app. Used to build sign-in links. Leave blank locally (auto-detected);
# set it in production, e.g. https://dotty.example.com
NEXT_PUBLIC_SITE_URL=

# ── AI (chat) ───────────────────────────────────────────────────────────────
# Vercel AI Gateway key — one key for every model (bots use Claude through it).
# Get it: https://vercel.com/dashboard → your team → AI Gateway → API Keys → Create key.
AI_GATEWAY_API_KEY=

# ── Background runs (Trigger.dev) ───────────────────────────────────────────
# Get these at https://cloud.trigger.dev → your project ("dotty"):
#   Project ref:  Project settings → "Project ref" (starts with proj_)
#   Secret key:   API keys → Development → Secret key (starts with tr_dev_)
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# ── Tools / connectors (Composio Platform) ──────────────────────────────────
# Project API key (starts with ak_): https://dashboard.composio.dev → Platform → your project →
# Settings → API Keys (or Getting Started → Step 1). Server only — never prefix with NEXT_PUBLIC_.
COMPOSIO_API_KEY=

# ── Chat channels: Telegram & Slack (Chat SDK) ──────────────────────────────
# State store: your Supabase Postgres connection string (server only). Supabase dashboard → Connect →
# "Session pooler" (port 5432) works everywhere; on Vercel you can use the "Transaction pooler" (6543).
# Use the database password, not an API key.
SUPABASE_DB_URL=
# Public https address Telegram and Slack call (webhooks, Slack sign-in). Locally: your ngrok URL
# (npm run tunnel). In production: your app URL. Free ngrok gives one fixed domain — put it in
# NGROK_DOMAIN (e.g. dotty-you.ngrok-free.app) so the address never changes.
CHAT_PUBLIC_URL=
NGROK_DOMAIN=

# Telegram: talk to @BotFather → /newbot → copy the token and the bot's username.
# Secret: run `npm run chat:secrets` and paste TELEGRAM_WEBHOOK_SECRET_TOKEN here.
# Then `npm run telegram:webhook` (locally, with ngrok running) or
# `npm run telegram:webhook -- https://your-domain` (production).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Slack: `npm run slack:manifest` prints the app manifest → https://api.slack.com/apps → Create New
# App → From a manifest. Copy Client ID / Client Secret / Signing Secret from Basic Information.
# SLACK_ENCRYPTION_KEY (encrypts bot tokens at rest): from `npm run chat:secrets`.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_ENCRYPTION_KEY=

# ── GitHub (Engineering) ─────────────────────────────────────────────────────
# Dotty's own GitHub App. Create it with `npm run github:app` (it fills these in for you).
# One app per environment: for production run `npm run github:app -- --url=https://your-domain`
# and put the values in Vercel and Trigger.dev. Bots then connect from Settings → Connectors → GitHub.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── Code runs (Engineering) ──────────────────────────────────────────────────
# Upstash Box sandbox for Engineering bots' code runs. Console → Box → API Keys (full access).
# Needed by Trigger.dev (put it there too in production). Never paste it in chat.
UPSTASH_BOX_API_KEY=

# ── Rate limits (optional) ──────────────────────────────────────────────────
# Upstash Redis shares rate limits across server instances. Without it each instance
# counts in memory (fine locally). Get it: https://console.upstash.com → Redis → Create
# database → REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
