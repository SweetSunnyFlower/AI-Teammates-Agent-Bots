# Dotty 自托管配置
# 复制为 .env.local 并填写实际值。

# ── 必需配置 ─────────────────────────────────────────────────────────────────
# PostgreSQL 13+ 连接字符串。应用、Better Auth、Chat SDK 状态和 pg-boss 都会使用它。
DATABASE_URL=postgresql://dotty:change-me@127.0.0.1:5432/dotty

# Better Auth 会话密钥，生成命令：
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# 应用的公开 HTTPS 地址，也供 Better Auth 和聊天 Webhook 使用。
# 本地浏览器使用 http://localhost:3000。
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# DeepSeek API Key。
DEEPSEEK_API_KEY=

# 自建 SearXNG JSON API。该地址仅限内部访问，Caddy 不应公开代理它。
SEARXNG_URL=http://127.0.0.1:8080
# 生成命令：openssl rand -hex 32
SEARXNG_SECRET=
# 以逗号分隔的 SearXNG 搜索引擎。google cse + 360search 在当前网络下可用；
# 海外网络也可以换成 mojeek，或其他可访问的引擎。
SEARXNG_ENGINES="google cse,360search"

# ── 邮箱验证与 Bot 邮件发送（SMTP）───────────────────────────────────────────
# Better Auth 用这些配置发送注册验证邮件，因此注册账户时 SMTP 是必需的。
# Bot 的 email.send 工具也会复用同一套配置。
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-provider-authorization-code
EMAIL_FROM=you@example.com

# ── 工程沙箱（Docker 或 Podman）──────────────────────────────────────────────
# 默认启用代码沙箱。只有需要禁用代码运行时才设为 false。
SANDBOX_ENABLED=true
# macOS/Windows 使用 Docker；Linux 可改为 podman（推荐 rootless）。
CONTAINER_BIN=docker
# "none" 最安全。只有代码运行必须安装依赖时才使用 "slirp4netns"。
SANDBOX_NETWORK=none
# 每次代码运行的临时仓库目录，worker 用户必须拥有写权限。
# macOS 示例：/Users/YOUR_NAME/.dotty/sandboxes
# Linux systemd 部署：/var/lib/dotty/sandboxes
DOTTY_SANDBOX_ROOT=/var/lib/dotty/sandboxes

# 可选的镜像覆盖配置。使用 `npm run sandbox:build` 构建。
SANDBOX_NODE_IMAGE=localhost/dotty-sandbox-node:latest
SANDBOX_PYTHON_IMAGE=localhost/dotty-sandbox-python:latest
SANDBOX_GOLANG_IMAGE=localhost/dotty-sandbox-golang:latest
SANDBOX_RUST_IMAGE=localhost/dotty-sandbox-rust:latest
SANDBOX_RUBY_IMAGE=localhost/dotty-sandbox-ruby:latest

# ── 可选应用工具（Composio）─────────────────────────────────────────────────
COMPOSIO_API_KEY=

# ── 可选聊天渠道（Telegram / Slack）─────────────────────────────────────────
CHAT_PUBLIC_URL=
NGROK_DOMAIN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_ENCRYPTION_KEY=

# ── 可选 GitHub App（工程）──────────────────────────────────────────────────
# 可以通过 `npm run github:app` 创建这些配置。
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── 可选调优 ─────────────────────────────────────────────────────────────────
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
PGBOSS_SCHEMA=pgboss
# 多实例或滚动部署时使用的固定 Server Action 密钥。
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
