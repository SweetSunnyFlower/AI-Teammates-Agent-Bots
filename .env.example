# Dotty self-hosted configuration
# Copy this file to .env.local and fill in the values.

# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL 13+ connection string. The app, Better Auth, Chat SDK state, and pg-boss use it.
DATABASE_URL=postgresql://dotty:change-me@127.0.0.1:5432/dotty

# Random secret for Better Auth sessions. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public HTTPS URL of the app. Also used by Better Auth and chat webhooks.
# For a local browser, use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# DeepSeek API key.
DEEPSEEK_API_KEY=

# Self-hosted SearXNG JSON API. The URL is private; Caddy should NOT expose it publicly.
SEARXNG_URL=http://127.0.0.1:8080
# Comma-separated SearXNG engine names. Mojeek is a practical default; add more when reachable.
SEARXNG_ENGINES=mojeek

# ── Local Engineering sandbox (rootless Podman) ─────────────────────────────
# Podman is enabled by default. Set to false only if you want to disable code runs.
PODMAN_ENABLED=true
PODMAN_BIN=podman
# "none" is safest. Use "slirp4netns" only if code runs must install dependencies.
PODMAN_SANDBOX_NETWORK=none
# Directory for per-run temporary repositories. Must be writable by the worker user.
DOTTY_SANDBOX_ROOT=/var/lib/dotty/sandboxes

# Optional image overrides. Build them with `npm run podman:build`.
PODMAN_NODE_IMAGE=localhost/dotty-sandbox-node:latest
PODMAN_PYTHON_IMAGE=localhost/dotty-sandbox-python:latest
PODMAN_GOLANG_IMAGE=localhost/dotty-sandbox-golang:latest
PODMAN_RUST_IMAGE=localhost/dotty-sandbox-rust:latest
PODMAN_RUBY_IMAGE=localhost/dotty-sandbox-ruby:latest

# ── Optional app tools (Composio) ───────────────────────────────────────────
COMPOSIO_API_KEY=

# ── Optional chat channels (Telegram / Slack) ───────────────────────────────
CHAT_PUBLIC_URL=
NGROK_DOMAIN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_ENCRYPTION_KEY=

# ── Optional GitHub App (Engineering) ───────────────────────────────────────
# `npm run github:app` can create these.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── Optional tuning ─────────────────────────────────────────────────────────
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
PGBOSS_SCHEMA=pgboss
# Stable Server Action key for multi-instance/rolling deployments.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
